# momentum-etf 배치 스케줄 정의 (타임존: Asia/Seoul)
#
# ⚠️ 운영 방식 변경 (2026-05 이후):
#   VM (1 OCPU ARM) 의 CPU 100% 다운 이슈로 VM cron 은 제거되었고,
#   모든 배치는 로컬(Mac) 의 `infra/server_scheduler.py` 에서 실행한다.
#   이 파일은 더 이상 VM 의 crontab 에 설치되지 않으며, 로컬 스케줄러가
#   배치 정의를 읽기 위한 단일 진실 소스(single source of truth) 로 쓰인다.
#
# 로컬 실행:
#   터미널1:  python run_local_dev.py        # 웹 (FastAPI + Next dev)
#   터미널2:  python infra/server_scheduler.py  # 배치 스케줄러
#
# 동작 원리:
#   `infra/server_scheduler.py` 가 이 파일을 파싱하여 APScheduler 에 등록한다.
#   각 라인은 `docker compose exec -T fastapi_app python` 부분이 제거된
#   뒤 호스트 venv 의 python 으로 직접 실행된다.
#
# 로그:
#   logs/cron/<job>.log 에 append 됩니다.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
APP_DIR=/home/ubuntu/apps/momentum-etf

# 기본 배치는 캘린더 평일(월~금, KST) 에 실행한다.
# cron 의 요일 필드: 1=월, 2=화, ..., 6=토

20 * * * 1-6 cd $APP_DIR && mkdir -p logs/cron && docker compose exec -T fastapi_app python infra/cron/run_batch.py cache_refresh python scripts/stock_price_cache_updater.py >> logs/cron/cache_refresh.log 2>&1
# 하루 1회 전체 재수집(--full) — 수정주가(배당·분할) 재정렬용. 매시 라인은 증분만 수행한다.
10 17 * * 1-5 cd $APP_DIR && mkdir -p logs/cron && docker compose exec -T fastapi_app python infra/cron/run_batch.py cache_refresh_full python scripts/stock_price_cache_updater.py --full >> logs/cron/cache_refresh_full.log 2>&1
45 7 * * 1-5 cd $APP_DIR && mkdir -p logs/cron && docker compose exec -T fastapi_app python infra/cron/run_batch.py reference_meta_updater python scripts/stock_reference_meta_updater.py >> logs/cron/reference_meta_updater.log 2>&1
50 7 * * 1-5 cd $APP_DIR && mkdir -p logs/cron && docker compose exec -T fastapi_app python infra/cron/run_batch.py price_metrics_updater python scripts/stock_price_metrics_updater.py >> logs/cron/price_metrics_updater.log 2>&1
*/10 * * * 1-6 cd $APP_DIR && mkdir -p logs/cron && docker compose exec -T fastapi_app python infra/cron/run_batch.py data_aggregate python scripts/collect_data.py >> logs/cron/data_aggregate.log 2>&1
40 9 * * 1-6 cd $APP_DIR && mkdir -p logs/cron && docker compose exec -T fastapi_app python infra/cron/run_batch.py asset_summary python scripts/slack_asset_summary.py >> logs/cron/asset_summary.log 2>&1
10 16 * * 1-5 cd $APP_DIR && mkdir -p logs/cron && docker compose exec -T fastapi_app python infra/cron/run_batch.py asset_summary python scripts/slack_asset_summary.py >> logs/cron/asset_summary.log 2>&1
0 7 * * 1-5 cd $APP_DIR && mkdir -p logs/cron && docker compose exec -T fastapi_app python infra/cron/run_batch.py market_hours_analysis python scripts/analyze_market_hours.py >> logs/cron/market_hours_analysis.log 2>&1
0 8 * * 1-5 cd $APP_DIR && mkdir -p logs/cron && docker compose exec -T fastapi_app python infra/cron/run_batch.py us_market_stocks python scripts/update_us_market_stocks.py >> logs/cron/us_market_stocks.log 2>&1
10 8 * * 1-5 cd $APP_DIR && mkdir -p logs/cron && docker compose exec -T fastapi_app python infra/cron/run_batch.py aus_market_stocks python scripts/update_aus_market_stocks.py >> logs/cron/aus_market_stocks.log 2>&1
# 시장 폭(ADR) — 한국 마감(15:30) 뒤 종가 확정 시각. 코스피 200 / 코스닥 150 의 일별 상승·하락 종목수를 적립한다.
30 16 * * 1-5 cd $APP_DIR && mkdir -p logs/cron && docker compose exec -T fastapi_app python infra/cron/run_batch.py market_breadth python scripts/collect_market_breadth.py >> logs/cron/market_breadth.log 2>&1
# 07:00 은 미국 마감(KST 새벽 05~06시) 뒤. 금요일 미국 장은 토요일 새벽에 끝나므로 화~토(2-6)에 돈다.
0 7 * * 2-6 cd $APP_DIR && mkdir -p logs/cron && docker compose exec -T fastapi_app python infra/cron/run_batch.py market_breadth python scripts/collect_market_breadth.py >> logs/cron/market_breadth.log 2>&1
# DB 백업 — 매시 fresh 백업(임시 폴더 → 성공 시 교체), 최근 30개 보존. 백업 폴더가 로컬(맥)이라 LOCAL 전용.
40 * * * * cd $APP_DIR && mkdir -p logs/cron && docker compose exec -T fastapi_app python infra/cron/run_batch.py db_backup python scripts/backup_mongo_full.py --gzip >> logs/cron/db_backup.log 2>&1

# 최근 1시간 |변동| >= LIVE_24H_ALERT_PCT 인 종목이 있을 때만 <!channel> 로 발송(없으면 스킵).
0 * * * * cd $APP_DIR && mkdir -p logs/cron && docker compose exec -T fastapi_app python infra/cron/run_batch.py live_24h_slack python scripts/live_24h_slack.py >> logs/cron/live_24h_slack.log 2>&1

# ── leverage 추천 (이동평균선 크로스, 한국+미국, 월-금) ─────────────────────
# 지수(코스피/나스닥100) 이동평균선 크로스 + 고점대비. DB(leverage_config) 저장 설정 기준.
# 각 시장은 자기 거래 달력 기준 '장 마감 직후'일 때만 슬랙을 1회 보낸다(당일 중복 방지).
# 한국 마감(15:30 KST)만 커버: 09:10·15:00·16:00 중 16:00 이 마감 직후라 한국 알림이 나간다.
# (미국 알림이 필요하면 미국 마감 05:05/06:05 KST 라인을 추가해야 한다 — 현재는 미제공.)
# (스케줄러는 스크립트 뒤 인자도 그대로 전달한다 — 예: cache_refresh_full 의 --full)
10 9 * * 1-5 cd $APP_DIR && mkdir -p logs/cron && docker compose exec -T fastapi_app python infra/cron/run_batch.py leverage_ma_cross python scripts/leverage_recommend_ma_cross.py >> logs/cron/leverage_ma_cross.log 2>&1
0 15,16 * * 1-5 cd $APP_DIR && mkdir -p logs/cron && docker compose exec -T fastapi_app python infra/cron/run_batch.py leverage_ma_cross python scripts/leverage_recommend_ma_cross.py >> logs/cron/leverage_ma_cross.log 2>&1

# ── 보유종목 알람 (20일선 이탈·손절, 평일 한국 개시 직후) ────────────────
# 계좌 마스터 On + 종류별 전역 On 계좌의 보유 종목 트리거를 모아 슬랙 1건 발송(없으면 미발송).
# 개시 직후라 판정은 직전(어제) 확정 종가/수익률 기준 — 오늘 매매 전 아침 알림.
10 9 * * 1-5 cd $APP_DIR && mkdir -p logs/cron && docker compose exec -T fastapi_app python infra/cron/run_batch.py holdings_alarm python scripts/holdings_alarm.py >> logs/cron/holdings_alarm.log 2>&1

# ── 전략 사고팔기 알림 (평일 09:10~15:20, 10분 간격) ──────────────────────
# kor_account 의 코스피200 ETF 6종을 회차로 보고, 매수/매도 지정가에 현재가가
# 닿은 회차가 있을 때만 슬랙 1건 발송(없으면 미발송). 같은 회차-동작은 하루 1회.
10,20,30,40,50 9 * * 1-5 cd $APP_DIR && mkdir -p logs/cron && docker compose exec -T fastapi_app python infra/cron/run_batch.py strategy_trade_notify python scripts/strategy_trade_notify.py >> logs/cron/strategy_trade_notify.log 2>&1
0,10,20,30,40,50 10-14 * * 1-5 cd $APP_DIR && mkdir -p logs/cron && docker compose exec -T fastapi_app python infra/cron/run_batch.py strategy_trade_notify python scripts/strategy_trade_notify.py >> logs/cron/strategy_trade_notify.log 2>&1
0,10,20 15 * * 1-5 cd $APP_DIR && mkdir -p logs/cron && docker compose exec -T fastapi_app python infra/cron/run_batch.py strategy_trade_notify python scripts/strategy_trade_notify.py >> logs/cron/strategy_trade_notify.log 2>&1
*/10 * * * 1-6 cd $APP_DIR && mkdir -p logs/cron && docker compose exec -T fastapi_app python infra/cron/run_batch.py new_high_notify python scripts/new_high_notify.py >> logs/cron/new_high_notify.log 2>&1
